#include <stdio.h>
void findmax(int fsmax[2],int i,int m,int b[][m]){
    int max=b[i][0],smax=-1;
    for(int k=0;k<m;k++){
        if(max<b[i][k]){
            smax=max;
            max=b[i][k];
        }
        else if(b[i][k]>smax)
        smax=b[i][k];
    }
    fsmax[0]=max;
    fsmax[1]=smax;
}

int main() {
	int n,m;
	scanf("%d%d",&n,&m);
	int a[n][m],b[n][m];
	int m1=0,m2=-1;
	for(int i=0;i<n;i++){
	    for(int j=0;j<m;j++){
	        scanf("%d",a[i][j]);
	        if(i==0){
	            b[i][j]=a[i][j];
	        }
	    }
	}
	int fsmax[2];
	for(int i=1;i<n;i++){
	    findmax(fsmax,i-1,m,b);
	    for(int j=0;j<m;j++){
	        b[i][j]=b[i][j]+(b[i-1][j]==fsmax[0])?fsmax[1]:fsmax[0];
	    }
	}
	printf("%d",findmax(int fsmax[2],n-1,m,b));
