import java.util.*;
public class Main
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int[] a=new int[n];
		for(int i=0;i<n;i++)a[i]=sc.nextInt();
		int target=sc.nextInt();
		int ans=solve(a,0,0,target);
		System.out.println(ans);

	}
	public static int solve(int[] a,int i,int sum,int target){
	    if(i==a.length)
	        return sum==target?1:0;
	    int x=solve(a,i+1,sum+a[i],target);
	    int y=solve(a,i+1,sum-a[i],target);
	    return x+y;
	}
}
