import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int m=sc.nextInt();
        int k=sc.nextInt();
        int[] a=new int[n];
        for(int i=0;i<n;i++)a[i]=sc.nextInt();
        int cur=0;
        boolean[] eaten=new boolean[n];
        for(int i=0;i<n;i++){
            if(i>=m && eaten[i-m]){
                cur=cur-a[i-m];
            }
            if(cur+a[i]<=k){
                System.out.println("Yes");
                cur+=a[i];
                eaten[i]=true;
            }
            else{
                System.out.println("No");
            }
        }
    }
}
