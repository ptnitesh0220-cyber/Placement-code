import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        while(t-->0){
            int n=sc.nextInt();
            int m=sc.nextInt();
            int[] a=new int[n];
            for(int i=0;i<n;i++)a[i]=sc.nextInt();int ans=0;
            for(int x=1;x<=m;x++){
                int c=0;
                for(int i=0;i<n;i++){
                    if(a[i]>=x)c++;
                    if(a[i]==2*x)c++;
                }
                ans=Math.max(ans,c);
                
            }
            System.out.println(ans);
        }
    }
}
