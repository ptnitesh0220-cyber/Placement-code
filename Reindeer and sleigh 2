import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t=sc.nextInt();
        while(t-->0){
            int n=sc.nextInt();
            long[] a=new long[n];
            long total=0;
            for(int i=0;i<n;i++){
                long w=sc.nextInt();
                long p=sc.nextInt();
                total+=p;
                a[i]=w+p;
            }
            Arrays.sort(a);
            long sum=0;
            int ans=0;
            for(long x:a){
                sum+=x;
                if(sum<=total)
                ans++;
                else break;
            }System.out.println(ans);
            
        }
        
    }
}
