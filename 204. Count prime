import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    Scanner sc=new Scanner(System.in);
	    int n=sc.nextInt();
	    int c=0;
	    boolean[] prime =new boolean[n];
	    for(int i=2;i<n;i++)
	        prime[i]=true;
	    for(int i=2;i*i<n;i++){
	        if(prime[i]){
	            for(int j=i*i;j<n;j+=i)
	            prime[j]=false;
	        }
	    }
	    for(int i=2;i<n;i++){
	        if(prime[i])c++;
	    }
	    System.out.println(c);
	}
}
