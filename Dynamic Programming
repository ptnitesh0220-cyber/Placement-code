import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    Scanner sc=new Scanner(System.in);
	    int n=sc.nextInt();
	    int m=sc.nextInt();
	    char[][] grid=new char[n][m];
	    int r=0,c=0,x=0,y=0;
	    for(int i=0;i<n;i++){
	    for(int j=0;j<m;j++){
	    grid[i][j]=sc.next().charAt(0);
	    if(grid[i][j]=='R'){
	        r=i;
	        c=j;
	    }
	    if(grid[i][j]=='C'){
	        x=i;
	        y=j;
	    }
	    }
	    }
	    boolean[][] dp=new boolean[n][m];
	    dp[r][c]=true;
	    for(int i=r;i<n;i++){
	        for(int j=c;j<m;j++){
	            if(grid[i][j]=='0' || grid[i][j]=='C'){
	                if(dp[i-1][j] || dp[i][j-1]){
	                    dp[i][j]=true;
	                    if(grid[i][j]=='C'){
	                        System.out.println("YES");
	                        return;
	                    }
	                }
	            }
	        }
	    }
	    System.out.println("NO");
	    
	    

	}
}
