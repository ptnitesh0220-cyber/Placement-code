import java.util.*;
import java.lang.*;
import java.io.*;
public class Main
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int k=sc.nextInt();
		int[] a=new int[k];
		for(int i=0;i<n;i++)a[sc.nextInt()-1]++;
		int max=0,ans=0;
		for(int x:a)max=Math.max(max,x);
		for(int x:a){
		    if(x+1>=max)ans++;
		}
		System.out.println(ans);
		

	}
}
