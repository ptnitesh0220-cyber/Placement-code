import java.util.*;
class Main
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int[] a=new int[n];
		for(int i=0;i<n;i++)a[i]=sc.nextInt();
		int k=sc.nextInt();
		k=k%n;
		int[] temp=new int[n];
		for(int i=0;i<n;i++)temp[(i+k)%n]=a[i];
		for(int i=0;i<n;i++)System.out.print(temp[i]+" ");
	}
}
